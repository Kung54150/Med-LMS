function markContentDone(courseId) {
  const user = requireLogin_();
  const sh = getSheet_(SHEET_PROGRESS);
  const data = sh.getDataRange().getValues();
  for (let i = 1; i < data.length; i++) {
    if (String(data[i][0]).toLowerCase() === user.email.toLowerCase() && data[i][1] === courseId) {
      sh.getRange(i + 1, 3).setValue(true);
