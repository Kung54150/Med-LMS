      { q: 'สัญญาณเตือนที่ควรพบแพทย์เพื่อพิจารณาตรวจคัดกรองมะเร็งลำไส้ใหญ่ตามที่โรงพยาบาลระบุคือข้อใด?', options: ['ปวดท้อง แน่นท้อง ท้องอืดบ่อย ร่วมกับน้ำหนักลด', 'ปวดศีรษะเรื้อรัง', 'ปวดข้อตามร่างกาย', 'ผื่นคันตามผิวหนัง'], answer: 0 },
      { q: 'ก่อนเข้ารับการส่องกล้อง ผู้ป่วยต้องลงนามในเอกสารใด?', options: ['ใบรับรองแพทย์', 'ใบยินยอมรับการรักษา (Consent Form)', 'ใบเบิกค่ารักษาพยาบาล', 'ใบนัดหมายแพทย์'], answer: 1 },
      { q: 'หากผู้ป่วยอายุต่ำกว่า 20 ปี ต้องเข้ารับการส่องกล้อง ต้องมีการดำเนินการใดเพิ่มเติม?', options: ['ไม่ต้องมีการยินยอมใดๆ เพิ่มเติม', 'ต้องรอจนอายุครบ 20 ปี', 'ให้ผู้ปกครองลงนามอนุญาตในใบยินยอมการรักษาด้วย', 'ให้แพทย์ 2 ท่านเซ็นยินยอมแทน'], answer: 2 },
      { q: 'ระหว่างการส่องกล้อง แพทย์มักให้ยาชนิดใดแก่ผู้ป่วยเพื่อลดปวดและคลายกังวล?', options: ['ยาปฏิชีวนะ', 'ยาลดกรด', 'ยาระบาย', 'ยานอนหลับที่ให้โดยการฉีดยา'], answer: 3 },
      { q: 'โอกาสเกิดภาวะแทรกซ้อนจากการทำ Gastroscopy อยู่ที่ประมาณเท่าใด?', options: ['ไม่เกิน 0.1% (1 ใน 1,000-10,000)', 'ประมาณ 10%', 'ประมาณ 25%', 'ประมาณ 50%'], answer: 0 },
      { q: 'ภาวะแทรกซ้อนที่อาจพบได้จากการทำ Colonoscopy โดยเฉพาะเมื่อมีการตัดติ่งเนื้อคือข้อใด?', options: ['ตาบอด', 'เลือดออกหรือลำไส้รั่ว', 'หูหนวก', 'ผมร่วง'], answer: 1 },
      { q: 'ก่อนทำ Gastroscopy ผู้ป่วยควรงดน้ำและอาหารอย่างน้อยกี่ชั่วโมง?', options: ['1 ชั่วโมง', '3 ชั่วโมง', '6 ชั่วโมง', '24 ชั่วโมง'], answer: 2 },
      { q: 'หากผู้ป่วยรับประทานยาละลายลิ่มเลือด เช่น aspirin, warfarin ก่อนทำ Gastroscopy ควรงดยาก่อนตรวจอย่างน้อยกี่วัน?', options: ['1 วัน', '3 วัน', 'ไม่ต้องงด', '7 วัน'], answer: 3 },
      { q: 'การเตรียมตัวก่อนทำ Colonoscopy ข้อใดถูกต้อง?', options: ['หลีกเลี่ยงอาหารกากใยสูงและรับประทานอาหารอ่อนก่อนตรวจ 1-2 วัน', 'รับประทานอาหารกากใยสูงก่อนตรวจ 1-2 วัน', 'ไม่ต้องเตรียมลำไส้ใดๆ', 'ดื่มน้ำอัดลมก่อนตรวจเพื่อล้างลำไส้'], answer: 0 },
      { q: 'ยาที่ใช้เตรียมลำไส้ก่อนทำ Colonoscopy ตามเอกสารของโรงพยาบาลคือข้อใด?', options: ['Paracetamol', 'Picoprep/Niflec/Swift', 'Amoxicillin', 'Omeprazole'], answer: 1 },
      { q: 'ก่อนเข้ารับการส่องกล้อง หากผู้ป่วยใส่ฟันปลอมหรือ contact lens ควรทำอย่างไร?', options: ['ใส่ไว้ตามปกติไม่ต้องถอด', 'ถอดหลังจากส่องกล้องเสร็จ', 'แจ้งเจ้าหน้าที่เพื่อถอดออกก่อนการส่องกล้อง', 'ไม่เกี่ยวข้องกับการส่องกล้อง'], answer: 2 },
      { q: 'หลังทำ Gastroscopy ผู้ป่วยควรงดน้ำและอาหารจนกว่าจะมีอาการใดหายไป?', options: ['อาการปวดศีรษะ', 'อาการง่วงนอน', 'อาการหิว', 'อาการชาในลำคอ'], answer: 3 },
      { q: 'หลังทำ Gastroscopy เมื่ออาการชาในลำคอหายไปแล้ว ควรทำอย่างไรก่อนดื่มน้ำหรือรับประทานอาหาร?', options: ['ทดลองจิบน้ำก่อน ถ้าไม่สำลักจึงดื่มน้ำและทานอาหารอ่อน', 'ดื่มน้ำอัดลมทันที', 'รับประทานอาหารมื้อหนักทันที', 'นอนหลับพักผ่อนอย่างเดียวโดยไม่ทานอะไร'], answer: 0 },
      { q: 'อาการใดหลังทำ Colonoscopy ที่ถือเป็นสัญญาณอันตรายต้องรีบแจ้งแพทย์ทันที?', options: ['ท้องอืดเล็กน้อย', 'เจ็บหน้าอก หัวใจเต้นแรงและเร็ว หายใจลำบาก', 'ง่วงนอนจากยาที่ได้รับ', 'หิวน้ำเล็กน้อย'], answer: 1 },
      { q: 'หลังทำ Colonoscopy และแพทย์อนุญาตให้กลับบ้านได้ ผู้ป่วยที่ได้รับยาฉีดให้หลับระหว่างตรวจควรปฏิบัติตัวอย่างไร?', options: ['ขับรถกลับบ้านได้ตามปกติ', 'สามารถทำงานหนักได้ทันที', 'ควรมีผู้ดูแลระหว่างเดินทางกลับ ไม่ควรขับรถเอง', 'ไม่มีข้อจำกัดใดๆ'], answer: 2 },
      { q: 'สำหรับผู้ที่ไม่สะดวกเข้ารับการส่องกล้องทางเดินอาหารส่วนล่าง มีทางเลือกอื่นในการวินิจฉัยคือข้อใด?', options: ['การตรวจเลือดทั่วไป', 'การตรวจปัสสาวะ', 'การเอกซเรย์ปอด', 'การกลืนแป้ง (Barium Enema) หรือ CT Colonography'], answer: 3 }
    ]
  },

  {
