/* ================= ทำแบบทดสอบ ================= */
function submitQuiz(courseId, answersIndexArray) {
  const user = requireLogin_();
  const course = COURSES.find(c => c.id === courseId);
  if (!course) throw new Error('ไม่พบบทเรียนนี้');

  // กันข้าม UI ยิงคำขอตรง ๆ: เช็กว่าอ่าน/ดูเนื้อหาครบเงื่อนไขในชีตแล้วจริงหรือไม่
  const psh = getSheet_(SHEET_PROGRESS);
  const pdata = psh.getDataRange().getValues();
  let contentDone = false;
  for (let i = 1; i < pdata.length; i++) {
    if (String(pdata[i][0]).toLowerCase() === user.email.toLowerCase() &&
        pdata[i][1] === courseId &&
        (pdata[i][2] === true || pdata[i][2] === 'TRUE')) {
      contentDone = true;
      break;
    }
  }
  if (!contentDone) {
    throw new Error('กรุณาอ่านเนื้อหา/ดูคลิปให้ครบเงื่อนไขก่อนทำแบบทดสอบ');
  }

  let correctCount = 0;
  const details = course.quiz.map((q, i) => {
    const chosen = answersIndexArray[i];
    const correct = chosen === q.answer;
    if (correct) correctCount++;
    return {
      q: q.q,
      chosenIndex: (chosen === undefined ? null : chosen),
      chosenText: (chosen === null || chosen === undefined) ? '(ไม่ได้เลือกคำตอบ)' : q.options[chosen],
      correctIndex: q.answer,
      correctText: q.options[q.answer],
      correct: correct
    };
  });

  const total = course.quiz.length;
  const pass = (correctCount / total) >= PASS_THRESHOLD;
  const attemptId = Utilities.getUuid(); // ใช้ผูกลายเซ็นอิเล็กทรอนิกส์เข้ากับผลสอบครั้งนี้โดยเฉพาะ

  const sh = getSheet_(SHEET_ATTEMPTS);
  sh.appendRow([
    new Date(), user.email, user.name, user.dept,
    course.id, course.title, correctCount, total, pass,
    JSON.stringify(details), attemptId
  ]);

if (correctCount === total && course.id !== 'S1') {

    try { awardPointsIfEligible_(user, course, attemptId); } catch (e) { /* ไม่ให้ปัญหาเรื่องแต้มไปบล็อกการส่งผลสอบ */ }

  }

  return { score: correctCount, total: total, pass: pass, passThresholdPct: Math.round(PASS_THRESHOLD * 100), details: details, attemptId: attemptId };
}

/* ================= ประวัติของตัวเอง (พนักงานเห็นได้เฉพาะของตัวเอง) ================= */
function getMyHistory() {
  const user = requireLogin_();
  const mySignatures = readSignatures_().filter(s => s.email.toLowerCase() === user.email.toLowerCase());
  return readAttempts_()
    .filter(a => a.email.toLowerCase() === user.email.toLowerCase())
    .map(a => {
      const sig = mySignatures.find(s => s.attemptId === a.id);
      return Object.assign({}, a, { hasSignature: !!sig, signatureDataUrl: sig ? sig.signatureDataUrl : null });
    });
}

function readAttempts_() {
  const sh = getSheet_(SHEET_ATTEMPTS);
  const data = sh.getDataRange().getValues();
  const rows = [];
  for (let i = 1; i < data.length; i++) {
    const r = data[i];
    if (!r[1]) continue;
    rows.push({
      id: r[10] || '',
      date: Utilities.formatDate(new Date(r[0]), Session.getScriptTimeZone() || 'Asia/Bangkok', 'yyyy-MM-dd HH:mm'),
      email: String(r[1]),
      name: r[2],
      dept: r[3],
      courseId: r[4],
      title: r[5],
      score: r[6],
      total: r[7],
      pass: (r[8] === true || r[8] === 'TRUE'),
      details: r[9] ? JSON.parse(r[9]) : []
    });
  }
  return rows;
}

/* ================= ลายเซ็นอิเล็กทรอนิกส์ (เซ็นหลังทำข้อสอบผ่าน เพื่อดึงไปใช้ในแบบฟอร์มบันทึกการอบรมประจำเดือน) ================= */
function readSignatures_() {
  // ใช้ getSheetByName() ตรง ๆ (ไม่ใช่ getSheet_ ที่ throw) เพราะฟังก์ชันนี้ถูกเรียกจาก getMyHistory()
  // ทุกครั้งที่พนักงานเปิดหน้าเว็บ — ถ้ายังไม่ได้สร้างชีต "Signatures" (เช่น เพิ่งอัปเดตโค้ดแต่ยังไม่ได้ทำตาม
  // SETUP_GUIDE.md ขั้นตอนสร้างชีตใหม่) ต้องไม่ทำให้หน้าภาพรวม/บทเรียนทั้งหมดพังไปด้วย จึงคืนค่าว่างแทนการ throw
  const sh = ss_().getSheetByName(SHEET_SIGNATURES);
  if (!sh) return [];
  const data = sh.getDataRange().getValues();
  const rows = [];
  for (let i = 1; i < data.length; i++) {
    const r = data[i];
    if (!r[1]) continue;
    rows.push({
      date: Utilities.formatDate(new Date(r[0]), Session.getScriptTimeZone() || 'Asia/Bangkok', 'yyyy-MM-dd HH:mm'),
      email: String(r[1]),
      name: r[2],
      dept: r[3],
      courseId: r[4],
      courseTitle: r[5],
      attemptId: r[6],
      signatureDataUrl: r[7]
    });
  }
  return rows;
}

// พนักงานเรียกหลังทำข้อสอบผ่านและวาดลายเซ็นบนหน้าเว็บ (signatureDataUrl คือรูปจาก <canvas>.toDataURL('image/png'))
// ตรวจสอบฝั่งเซิร์ฟเวอร์ว่า attemptId นี้เป็นผลสอบที่ "ผ่านจริง" และเป็นของผู้ที่ล็อกอินอยู่จริง กันการปลอมแปลง/เซ็นแทนคนอื่น
function saveSignature(attemptId, signatureDataUrl) {
  const user = requireLogin_();
  if (!signatureDataUrl || String(signatureDataUrl).indexOf('data:image') !== 0) {
    throw new Error('ข้อมูลลายเซ็นไม่ถูกต้อง กรุณาลองเซ็นใหม่อีกครั้ง');
  }
  const match = readAttempts_().find(a => a.id === attemptId && a.email.toLowerCase() === user.email.toLowerCase() && a.pass);
  if (!match) {
    throw new Error('ไม่พบผลสอบที่ผ่านเกณฑ์ตรงกับรายการนี้ หรือคุณไม่มีสิทธิ์ลงชื่อสำหรับผลสอบนี้');
  }
  const sh = getSheet_(SHEET_SIGNATURES);
  sh.appendRow([new Date(), user.email, user.name, user.dept, match.courseId, match.title, attemptId, signatureDataUrl]);
  return true;
}

/* ================= สิทธิ์ผู้ดูแลระบบ (Admin / HR / หัวหน้างาน) ================= */
function requireLogin_() {
  const user = getCurrentUser();
  if (!user.ok) throw new Error(user.message);
