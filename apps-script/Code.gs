/* ================= Sheet helpers ================= */
function ss_() {
  return SpreadsheetApp.getActiveSpreadsheet();
}

function getSheet_(name) {
  const sh = ss_().getSheetByName(name);
  if (!sh) throw new Error('ไม่พบชีต "' + name + '" กรุณาตรวจสอบตาม SETUP_GUIDE.md');
  return sh;
}

/* ================= ผู้ใช้งานปัจจุบัน ================= */
function getCurrentUser() {
  const email = Session.getActiveUser().getEmail();
  if (!email) {
    return { ok: false, message: 'ไม่พบอีเมลผู้ใช้งาน กรุณาเข้าสู่ระบบด้วยบัญชี Google ของบริษัทก่อน' };
  }
  const sh = getSheet_(SHEET_USERS);
  const data = sh.getDataRange().getValues();
  const headers = data[0];
  const idxEmail = headers.indexOf('Email');
  const idxName = headers.indexOf('Name');
  const idxDept = headers.indexOf('Department');
  const idxRole = headers.indexOf('Role');
 

  for (let i = 1; i < data.length; i++) {
    if (String(data[i][idxEmail]).trim().toLowerCase() === email.trim().toLowerCase()) {
      return {
        ok: true,
        email: email,
        name: data[i][idxName] || email,
        dept: data[i][idxDept] || '-',
        role: String(data[i][idxRole] || 'employee').toLowerCase()
      };
    }
  }
  return { ok: false, message: 'บัญชี ' + email + ' ยังไม่ได้ถูกเพิ่มในระบบ กรุณาติดต่อผู้ดูแลระบบให้เพิ่มชื่อในชีต Users' };
}

/* ================= บทเรียน ================= */

function getCourses() {
  const user = requireLogin_();
  const isAdmin = (user.role === 'admin' || user.role === 'hr');
  const now = new Date();
  const baseUrl = ScriptApp.getService().getUrl();

  return COURSES.map(c => {
    const scheduled = !!(c.publishAt && new Date(c.publishAt) > now);
    const locked = scheduled && !isAdmin; // พนักงานเห็นหัวข้อได้ แต่เปิดอ่านเนื้อหาไม่ได้จนถึงเวลา

    // บทเรียนที่ฝังเป็นหน้าเว็บย่อยแยกต่างหาก (เช่น เครื่องมือฝึกแบบโต้ตอบ) ใช้ embedPage แทน content ตรงๆ
    const embeddedContent = c.embedPage
      ? '<iframe src="' + baseUrl + '?page=' + c.embedPage + '" style="width:100%;height:820px;border:none;border-radius:10px;" title="' + c.title + '"></iframe>' +
        '<p style="margin-top:10px;font-size:12.5px;"><a href="' + baseUrl + '?page=' + c.embedPage + '" target="_blank" rel="noopener">เปิดแบบเต็มหน้าจอในแท็บใหม่ ↗</a></p>'
      : (c.content || null);

    return {
      id: c.id,
      title: c.title,
      desc: c.desc,
      thumbnail: c.thumbnail || null,
      category: c.category || 'ทั่วไป',
      type: c.type,
      // ไม่ส่งเนื้อหา/คำถามไปเลยถ้ายังไม่เผยแพร่และไม่ใช่แอดมิน กันดักอ่านผ่าน dev tools ล่วงหน้า
      content: locked ? null : embeddedContent,
      videoUrl: locked ? null : (c.videoUrl || null),
      // (c.quiz || []) กันพังกรณีบทเรียนไม่มีแบบทดสอบเลย
      questions: locked ? [] : (c.quiz || []).map(q => ({ q: q.q, options: q.options })),
      publishAt: c.publishAt || null,
      scheduled: scheduled,
      locked: locked
    };
  });
}



/* ================= ความคืบหน้าการอ่าน/ดูเนื้อหา ================= */
function getMyProgress() {
