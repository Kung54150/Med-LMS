}
/* ==================================================================

   รายงานกระดาษคำตอบรายบุคคล + ส่งออกข้อมูลรายข้อ

   ทุกชื่อขึ้นต้นด้วย Exam_ หรือ getExam / buildExam กันชนกับของเดิม

   ================================================================== */

function Exam_requireAdmin_() {

  var u = requireLogin_();

  var role = String(u.role || '').toLowerCase();

  if (role !== 'admin' && role !== 'hr') throw new Error('เฉพาะผู้ดูแลระบบเท่านั้น');

  return u;

}

function Exam_rows_(sheetName) {

  var sh = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(sheetName);

  if (!sh) return [];

  var v = sh.getDataRange().getValues();

  if (v.length < 2) return [];

  var head = v[0].map(function (h) { return String(h).trim(); });

  var out = [];

  for (var i = 1; i < v.length; i++) {

    var blank = v[i].every(function (c) { return String(c).trim() === ''; });

    if (blank) continue;

    var o = {};

    head.forEach(function (h, j) { o[h] = v[i][j]; });

    out.push(o);

  }

  return out;

}

function Exam_fmt_(d) {

  if (d instanceof Date) return Utilities.formatDate(d, Session.getScriptTimeZone(), 'dd/MM/yyyy HH:mm น.');

  return String(d || '');

}

/** รายชื่อพนักงาน + บทเรียน สำหรับช่องเลือกในหน้าเว็บ */

function getExamFilters() {

  Exam_requireAdmin_();

  var users = Exam_rows_('Users')
  .filter(function (u) {
    return String(u.Email || '').trim() !== '';
  })

    .map(function (u) {

      return { email: String(u.Email).trim(), name: String(u.Name || u.Email), dept: String(u.Department || '') };

    });

  var seen = {}, courses = [];

  Exam_rows_('Attempts').forEach(function (a) {

    var id = String(a.CourseId || '');

    if (!id || seen[id]) return;

    seen[id] = 1;

    courses.push({ id: id, title: String(a.CourseTitle || id) });

  });

  return { users: users, courses: courses };

}

/** ดึงกระดาษคำตอบ  opts = { email:'', courseId:'', latestOnly:true } */

function getExamPapers(opts) {

  Exam_requireAdmin_();

  opts = opts || {};

  var wantEmail  = String(opts.email || '').trim().toLowerCase();

  var wantCourse = String(opts.courseId || '').trim();

  var latestOnly = opts.latestOnly !== false;

  var users = {};

  Exam_rows_('Users').forEach(function (u) {

    users[String(u.Email || '').trim().toLowerCase()] =

      { name: String(u.Name || ''), dept: String(u.Department || ''), role: String(u.Role || '').toLowerCase() };

  });

  var sigs = {};

  Exam_rows_('Signatures').forEach(function (s) {

    var id = String(s.AttemptId || '').trim();

    if (!id) return;

    sigs[id] = {

      url:  String(s.SignatureDataUrl || ''),

            when: Exam_fmt_(s.Timestamp || s.Date)

    };

  });



  var out = [];

  Exam_rows_('Attempts').forEach(function (a) {

    var email = String(a.Email || '').trim().toLowerCase();

    if (!email) return;

    var info = users[email] || {};

    if (wantEmail && email !== wantEmail) return;

    if (wantCourse && String(a.CourseId || '') !== wantCourse) return;

    var details = [];

    try { details = JSON.parse(a.DetailsJSON || '[]'); } catch (e) { details = []; }

    out.push({

      attemptId: String(a.AttemptId || ''),

      email: email,

      name: info.name || String(a.Name || email),

      dept: info.dept || String(a.Department || ''),

      courseId: String(a.CourseId || ''),

      courseTitle: String(a.CourseTitle || ''),

      score: Number(a.Score || 0),

      total: Number(a.Total || 0),

      pass: (a.Pass === true || String(a.Pass).toUpperCase() === 'TRUE'),

      when: Exam_fmt_(a.Timestamp),

      whenRaw: (a.Timestamp instanceof Date) ? a.Timestamp.getTime() : 0,

      signature: (sigs[String(a.AttemptId || '').trim()] || {}).url  || '',

      signedAt:  (sigs[String(a.AttemptId || '').trim()] || {}).when || '',

      hasSig:    !!(sigs[String(a.AttemptId || '').trim()] || {}).url,



      items: details.map(function (d, i) {

        return {

          no: i + 1,

          q: String(d.q || ''),

          chosen: String(d.chosenText || '(ไม่ได้ตอบ)'),

          answer: String(d.correctText || ''),

          correct: !!d.correct

        };

      })

    });

  });

  out.sort(function (x, y) { return y.whenRaw - x.whenRaw; });

  if (latestOnly) {

    var seen = {}, keep = [];

    out.forEach(function (p) {

      var k = p.email + '|' + p.courseId;

      if (!seen[k]) { seen[k] = 1; keep.push(p); }

    });

    out = keep;

  }

  return out;

}

/** สร้างชีตข้อมูลรายข้อสำหรับวิเคราะห์ต่อ (1 แถว = 1 คำถาม) */

function buildExamStatsSheet(opts) {

  Exam_requireAdmin_();

  var papers = getExamPapers(opts);

  var ss = SpreadsheetApp.getActiveSpreadsheet();

  var name = 'ExamStats_' + Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'yyyyMMdd_HHmmss');

  var sh = ss.insertSheet(name);

  var rows = [[

    'วันที่ทำ', 'อีเมล', 'ชื่อ-สกุล', 'แผนก', 'รหัสบทเรียน', 'บทเรียน',

    'คะแนน', 'คะแนนเต็ม', 'ร้อยละ', 'ผลการสอบ',

    'ข้อที่', 'คำถาม', 'คำตอบที่เลือก', 'คำตอบที่ถูก', 'ถูก/ผิด', 'เซ็นชื่อแล้ว'

  ]];

  papers.forEach(function (p) {

    var pct = p.total ? Math.round(p.score / p.total * 100) : 0;

    var head = [p.when, p.email, p.name, p.dept, p.courseId, p.courseTitle,

                p.score, p.total, pct, p.pass ? 'ผ่าน' : 'ไม่ผ่าน'];

    if (!p.items.length) {

      rows.push(head.concat(['', '', '', '', '', p.signature ? 'ใช่' : 'ไม่']));

      return;

    }

    p.items.forEach(function (it) {

      rows.push(head.concat([it.no, it.q, it.chosen, it.answer,

                             it.correct ? 'ถูก' : 'ผิด', p.signature ? 'ใช่' : 'ไม่']));

    });

  });

  sh.getRange(1, 1, rows.length, rows[0].length).setValues(rows);

  sh.getRange(1, 1, 1, rows[0].length).setFontWeight('bold').setBackground('#e8eefc');

  sh.setFrozenRows(1);

  sh.autoResizeColumns(1, rows[0].length);

  return { url: ss.getUrl() + '#gid=' + sh.getSheetId(), sheetName: name, rows: rows.length - 1 };

}
