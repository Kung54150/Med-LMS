    const email = data[i][idxEmail];
    const isSelfAdminLearner = String(email).toLowerCase() === 'sawitree.t83@gmail.com';
    if ((role === 'admin' || role === 'hr') && !isSelfAdminLearner) continue; // แสดงเฉพาะพนักงานที่ต้องเรียน + บัญชีของสาวิตรีที่เรียนเองด้วย
    const emailLower = String(email).toLowerCase();
    const mine = attempts.filter(a => a.email.toLowerCase() === emailLower);
    const quizCount = mine.length;
    const avg = quizCount ? Math.round(mine.reduce((s, a) => s + (a.score / a.total * 100), 0) / quizCount) : 0;
    const wrongTotal = mine.reduce((s, a) => s + a.details.filter(d => !d.correct).length, 0);
        // CPR / ACLS (S1): ตัดสินจากผลฝึกจริงรายบทบาท ตามตำแหน่ง — RN ต้องผ่านครบ 4 บทบาท, PN/NA ต้องผ่าน Airway
    const posTxt = idxPos > -1 ? String(data[i][idxPos] || '').toUpperCase() : '';
    const isPn = posTxt.indexOf('PN') > -1 || posTxt.indexOf('NA') > -1 || posTxt.indexOf('ผู้ช่วย') > -1;
    const cprDone = {};
    mine.forEach(a => { if (a.pass && String(a.courseId).indexOf('CPR-') === 0) cprDone[a.courseId] = true; });
    const cprNeed = isPn ? ['CPR-airway'] : CPR_SUB_LESSONS.map(l => 'CPR-' + l.id);
    const cprHave = cprNeed.filter(id => cprDone[id]).length;
    const cprOk = cprHave === cprNeed.length;
    const cprStarted = mine.some(a => String(a.courseId).indexOf('CPR-') === 0);
    const cprNote = isPn
      ? 'PN/NA · ' + (cprOk ? 'Airway ✓' : 'ต้องผ่าน Airway')
      : 'RN · ' + cprHave + '/' + cprNeed.length + ' บทบาท';

    const completedCourseIds = [...new Set(mine.filter(a => a.pass).map(a => a.courseId))]
      .filter(id => id !== 'S1' && String(id).indexOf('CPR-') !== 0);
    if (cprOk) completedCourseIds.push('S1');

    // สถานะรายบทเรียนต่อคน เพื่อให้ Admin เห็นชัดว่าใครยังไม่ผ่านบทเรียนใดโดยไม่ต้องกดดูรายละเอียด
    const courseStatus = COURSES.map(c => {
      if (c.id === 'S1') {
        const started = cprStarted || !!(progressMap[emailLower] && progressMap[emailLower].S1);
        return { id: c.id, title: c.title, status: cprOk ? 'passed' : (started ? 'not_passed' : 'not_started'), note: cprNote };
      }
      const passed = completedCourseIds.indexOf(c.id) > -1;
      if (passed) return { id: c.id, title: c.title, status: 'passed' };
      const started = !!(progressMap[emailLower] && progressMap[emailLower][c.id]) || mine.some(a => a.courseId === c.id);
      return { id: c.id, title: c.title, status: started ? 'not_passed' : 'not_started' };
    });
    employees.push({
      email: email,
      name: data[i][idxName],
      dept: data[i][idxDept],
      completedCourses: completedCourseIds.length,
      totalCourses: COURSES.length,
      quizCount: quizCount,
      avgScore: avg,
      wrongTotal: wrongTotal,
      courseStatus: courseStatus
    });
  }
  return employees;
}

function getEmployeeDetail(email) {
  requireAdmin_();
  const emailLower = String(email).toLowerCase();
  const signatures = readSignatures_().filter(s => s.email.toLowerCase() === emailLower);
  return readAttempts_()
    .filter(a => a.email.toLowerCase() === emailLower)
    .map(a => {
      const sig = signatures.find(s => s.attemptId === a.id);
      return Object.assign({}, a, { hasSignature: !!sig, signatureDataUrl: sig ? sig.signatureDataUrl : null, signedDate: sig ? sig.date : null });
    });
}

/* ================= สร้างแบบฟอร์ม OJT (FR ของโรงพยาบาล) พร้อมลายเซ็น =================
   หลักการสำคัญ: ห้ามแก้ไขไฟล์/ชีตต้นแบบ (SHEET_OJT_TEMPLATE) เด็ดขาด เพราะเป็นแบบฟอร์มที่โรงพยาบาลกำหนด (Controlled Document)
   ทุกครั้งที่เรียกฟังก์ชันนี้ ระบบจะ "คัดลอก" ชีตต้นแบบไปเป็นชีตใหม่ก่อนเสมอ แล้วเติมข้อมูลลงในชีตสำเนานั้นเท่านั้น
   ชีตต้นแบบตัวจริงจะไม่ถูกแตะต้องไม่ว่ากรณีใด — และเติมให้เฉพาะ 3 ช่องที่ระบบมีข้อมูลจริงคือ ลำดับที่ / ชื่อ-สกุล / ลายเซ็น
   ส่วนช่องอื่น ๆ ในฟอร์ม (ตำแหน่ง, วันที่, วิธีประเมิน, ผ่าน/ไม่ผ่าน, แผนกอบรม, เวลา, สถานที่ ฯลฯ) เว้นว่างไว้ให้กรอกเองตามเดิม */
function buildOjtExportSheet(courseId) {
  requireAdmin_();
    const course = COURSES.find(c => c.id === courseId) || EKG_OJT_COURSES.find(c => c.id === courseId) || CPR_OJT_COURSES.find(c => c.id === courseId);
  if (!course) throw new Error('ไม่พบบทเรียนนี้');

  const ss = ss_();
  const template = ss.getSheetByName(SHEET_OJT_TEMPLATE);
  if (!template) {
    throw new Error('ไม่พบชีตต้นแบบ "' + SHEET_OJT_TEMPLATE + '" กรุณา Import ไฟล์แบบฟอร์ม OJT ของโรงพยาบาลเป็นแท็บใหม่ชื่อนี้ก่อน (ดูวิธีทำใน SETUP_GUIDE.md หัวข้อ "ลายเซ็นอิเล็กทรอนิกส์")');
  }

  const signatures = readSignatures_().filter(s => s.courseId === courseId);
  const latestByEmail = {};
  signatures.forEach(s => { latestByEmail[s.email.toLowerCase()] = s; });
  const signedList = Object.values(latestByEmail);
  if (!signedList.length) {
    throw new Error('ยังไม่มีพนักงานคนใดเซ็นชื่อยืนยันสำหรับบทเรียนนี้ ยังสร้างแบบฟอร์มไม่ได้');
  }

  const stamp = Utilities.formatDate(new Date(), Session.getScriptTimeZone() || 'Asia/Bangkok', 'yyyyMMdd_HHmmss');
  const copy = template.copyTo(ss).setName('OJT_' + course.id + '_' + stamp);
    try { ss.setActiveSheet(copy); ss.moveActiveSheet(ss.getNumSheets()); } catch (e) {}
  SpreadsheetApp.flush();

  const hdr = Ojt_fillHeader2_(copy, course);
  const FIRST_ROW = 13;
  const ROWS_PER_PERSON = 3;
  const COL_NAME = 4;  // D
  const COL_SIG  = 15; // O

   // จับคู่ชื่อแบบผ่อนปรน 3 ชั้น กันกรณีสะกดต่างกันเล็กน้อย เช่น สระซ้อน หรือพยัญชนะเกิน

  const norm  = s => String(s || '').replace(/\s+/g, '').trim();

  const dedup = s => norm(s).replace(/(.)\1+/g, '$1');                            // สุุ -> สุ

  const bare  = s => dedup(s).replace(/[ัิ-ฺ็-๎]/g, ''); // ตัดสระ/วรรณยุกต์

  const mapExact = {}, mapDedup = {}, mapBare = {};

  signedList.forEach(s => {

    mapExact[norm(s.name)]  = s;

    mapDedup[dedup(s.name)] = s;

    mapBare[bare(s.name)]   = s;

  });


  let matchedCount = 0;
  const failedNames = [];
   const noSigNames = [];
  const maxRows = copy.getMaxRows();

  function insertSignatureImage_(sig, blockStart) {
    // ใช้ความสูงของแถวที่ 1 และ 2 ของบล็อกรวมกัน เพื่อให้ลายเซ็นใหญ่ขึ้น
    const rowH1 = copy.getRowHeight(blockStart) || 20;
    const rowH2 = copy.getRowHeight(blockStart + 1) || 20;
    const targetH = Math.max(20, Math.min(60, rowH1 + rowH2 - 4));
    const parts = String(sig.signatureDataUrl).split(',');
    const meta = parts[0];
    const contentType = meta.substring(5, meta.indexOf(';'));
    const bytes = Utilities.base64Decode(parts[1]);
    const blob = Utilities.newBlob(bytes, contentType, 'signature.png');
    const img = copy.insertImage(blob, COL_SIG, blockStart);
    img.setWidth(Math.round(targetH * 2.4)).setHeight(targetH);
  }

  for (let blockStart = FIRST_ROW; blockStart + ROWS_PER_PERSON - 1 <= maxRows; blockStart += ROWS_PER_PERSON) {
    const nameInSheet = copy.getRange(blockStart, COL_NAME).getValue();
    const nameKey = norm(nameInSheet);
    if (!nameKey) continue;

    const sig = mapExact[nameKey]

             || mapDedup[dedup(nameInSheet)]

             || mapBare[bare(nameInSheet)];

     if (!sig) { noSigNames.push(String(nameInSheet).trim()); continue; }


    let inserted = false;
    for (let attempt = 1; attempt <= 3 && !inserted; attempt++) {
      try {
        insertSignatureImage_(sig, blockStart);
        SpreadsheetApp.flush();
        inserted = true;
      } catch (e) {
        if (attempt < 3) Utilities.sleep(attempt * 400);
      }
    }
    if (!inserted) failedNames.push(String(nameInSheet).trim());

    // ย้าย timestamp ลงมาอีก 1 บรรทัด เพื่อเปิดพื้นที่ให้ลายเซ็นใหญ่ขึ้น
    copy.getRange(blockStart + 2, COL_SIG).setValue(sig.date).setFontSize(8);

    matchedCount++;
  }

  SpreadsheetApp.flush();
    return {
    sheetUrl: ss.getUrl() + '#gid=' + copy.getSheetId(),
    count: matchedCount,
    sheetName: copy.getName(),
    failedNames: failedNames,
    noSigNames: noSigNames
  };
}

/* ================= รายงานสำหรับ Admin (ดาวน์โหลดเป็น CSV) ================= */
function buildReportCSV() {
  requireAdmin_();
  const attempts = readAttempts_();
  const header = ['วันที่', 'อีเมล', 'ชื่อ', 'แผนก', 'บทเรียน', 'คะแนน', 'เต็ม', 'ร้อยละ', 'ผลลัพธ์'];
  const rows = [header.map(csvEscape_).join(',')];
  attempts.forEach(a => {
    const pct = Math.round((a.score / a.total) * 100);
    rows.push([
      a.date, a.email, a.name, a.dept, a.title,
      a.score, a.total, pct, a.pass ? 'ผ่าน' : 'ไม่ผ่าน'
    ].map(csvEscape_).join(','));
  });
  return rows.join('\n');
}

function csvEscape_(v) {
  const s = String(v === null || v === undefined ? '' : v);
  if (s.indexOf(',') > -1 || s.indexOf('"') > -1 || s.indexOf('\n') > -1) {
    return '"' + s.replace(/"/g, '""') + '"';
  }
  return s;
}
/* ================= ระบบสะสมแต้ม (Points) ================= */

const SHEET_POINTS = 'Points';

const SHEET_REDEMPTIONS = 'Redemptions';

const SHEET_CODESTOCK = 'CodeStock';

const CODESTOCK_LOW_THRESHOLD = 2;

const POINTS_TO_REDEEM = 50;

const POINTS_QUOTA_PER_COURSE = 5;

const POINTS_BY_RANK = [5, 4, 3, 2, 1]; // อันดับ 1-5 ที่ทำเต็ม 100% คนแรกในแต่ละบทเรียน

// ดึงรหัสถัดไปที่ยังไม่ถูกใช้จากคลัง (เรียงจากบนลงล่าง)

function getNextAvailableCode_() {

  const sh = getSheet_(SHEET_CODESTOCK);

  const data = sh.getDataRange().getValues();

  for (let i = 1; i < data.length; i++) {

    const status = String(data[i][2] || '').trim();

    if (status !== 'Used' && data[i][0]) {

      return { rowIndex: i + 1, serialNumber: data[i][0], pinCode: data[i][1] };

    }

  }

  return null;

}

// นับจำนวนรหัสที่เหลืออยู่ในคลัง (ยังไม่ถูกใช้)

function countAvailableCodes_() {

  const sh = getSheet_(SHEET_CODESTOCK);

  const data = sh.getDataRange().getValues();

  let count = 0;

  for (let i = 1; i < data.length; i++) {

    const status = String(data[i][2] || '').trim();

    if (status !== 'Used' && data[i][0]) count++;

  }

  return count;

}

// ทำเครื่องหมายว่ารหัสแถวนี้ถูกใช้ไปแล้ว พร้อมบันทึกว่าใครใช้เมื่อไหร่

function markCodeUsed_(rowIndex, user) {

  const sh = getSheet_(SHEET_CODESTOCK);

  sh.getRange(rowIndex, 3).setValue('Used');

  sh.getRange(rowIndex, 4).setValue(user.email);

  sh.getRange(rowIndex, 5).setValue(user.name);

  sh.getRange(rowIndex, 6).setValue(new Date());

}

// ส่งอีเมลแจ้งเตือนแอดมิน/HR ทุกคน เมื่อรหัสในคลังเหลือน้อย

function notifyAdminLowStock_(remaining) {

  try {

    const data = getSheet_(SHEET_USERS).getDataRange().getValues();

    const headers = data[0];

    const idxEmail = headers.indexOf('Email');

    const idxRole = headers.indexOf('Role');

    const adminEmails = [];

    for (let i = 1; i < data.length; i++) {

      const role = String(data[i][idxRole] || '').toLowerCase();

      if (role === 'admin' || role === 'hr') adminEmails.push(data[i][idxEmail]);

    }

    if (!adminEmails.length) return;

    MailApp.sendEmail({

      to: adminEmails.join(','),

      subject: '⚠️ รหัส LINE credit เหลือน้อย (' + remaining + ' รหัส)',

      body: 'ระบบสะสมแต้มพนักงาน OPD1 แจ้งเตือน: รหัส Serial Number/PIN สำหรับแลก LINE credit ในชีต "CodeStock" เหลืออยู่เพียง ' + remaining + ' รหัสเท่านั้น กรุณาเติมรหัสใหม่เข้าไปในชีตโดยเร็ว เพื่อไม่ให้พนักงานแลกแต้มไม่ได้'

    });

  } catch (e) { /* ไม่ให้ error เรื่องอีเมลไปกระทบการแลกแต้มหลัก */ }

}

// ให้แอดมินเช็คสต็อกคงเหลือจากหน้าเว็บได้

function getCodeStockCount() {

  requireAdmin_();

  return { remaining: countAvailableCodes_(), threshold: CODESTOCK_LOW_THRESHOLD };

}


// เรียกจาก submitQuiz() เมื่อทำได้เต็ม 100% เท่านั้น ไม่ทำให้การส่งข้อสอบพังแม้แต้มจะ error
function awardPointsIfEligible_(user, course, attemptId) {
  if (!canEarnPoints_(user)) return;   // หัวหน้า (Position มีคำว่า หัวหน้า) / admin / hr ไม่สะสมแต้ม
  const sh = getSheet_(SHEET_POINTS);
  const data = sh.getDataRange().getValues();

  // เคยได้แต้มจากบทเรียนนี้ไปแล้วหรือยัง (คนเดิม ได้ครั้งเดียวต่อบทเรียน)
  let countForCourse = 0;
  for (let i = 1; i < data.length; i++) {
    if (data[i][4] === course.id) {
      countForCourse++;
      if (String(data[i][1]).toLowerCase() === user.email.toLowerCase()) return; // เคยได้แล้ว ไม่ให้ซ้ำ
    }
  }

  if (countForCourse >= POINTS_QUOTA_PER_COURSE) return; // เต็มโควต้า 5 คนแรกของบทเรียนนี้แล้ว

  if (getPointsBalance_(user.email) >= POINTS_TO_REDEEM) return; // แต้มค้างครบ 50 ต้องแลกก่อนถึงจะสะสมเพิ่มได้

  const rank = countForCourse + 1;
  const points = POINTS_BY_RANK[rank - 1];
  sh.appendRow([new Date(), user.email, user.name, user.dept, course.id, course.title, rank, points, attemptId]);
}

// ยอดแต้มปัจจุบัน = แต้มที่ได้ทั้งหมด - แต้มที่เคยกดแลกไปแล้วทั้งหมด (กดแลก = หักทันที ไม่รอแอดมิน)
function getPointsBalance_(email) {
  const emailLower = String(email).toLowerCase();

  const earnData = getSheet_(SHEET_POINTS).getDataRange().getValues();
  let earned = 0;
  for (let i = 1; i < earnData.length; i++) {
    if (String(earnData[i][1]).toLowerCase() === emailLower) earned += Number(earnData[i][7]) || 0;
  }

  const redData = getSheet_(SHEET_REDEMPTIONS).getDataRange().getValues();
  let redeemed = 0;
  for (let i = 1; i < redData.length; i++) {
    if (String(redData[i][1]).toLowerCase() === emailLower) redeemed += Number(redData[i][4]) || 0;
  }

  return earned - redeemed;
}

// เรียกจากหน้า "เช็คแต้มสะสม" ของพนักงาน
function getMyPoints() {
  const user = requireLogin_();
  const emailLower = user.email.toLowerCase();
  const tz = Session.getScriptTimeZone() || 'Asia/Bangkok';

  const earnData = getSheet_(SHEET_POINTS).getDataRange().getValues();
  const history = [];
  for (let i = 1; i < earnData.length; i++) {
    if (String(earnData[i][1]).toLowerCase() === emailLower) {
      history.push({
        date: Utilities.formatDate(new Date(earnData[i][0]), tz, 'dd/MM/yyyy HH:mm'),
        courseTitle: earnData[i][5],
        rank: earnData[i][6],
        points: earnData[i][7]
      });
    }
  }
  history.reverse();

  const redData = getSheet_(SHEET_REDEMPTIONS).getDataRange().getValues();

  let pending = null;

  const fulfilledList = [];

  for (let i = 1; i < redData.length; i++) {

    if (String(redData[i][1]).toLowerCase() === emailLower) {

      const status = redData[i][5];

      const row = {

        date: Utilities.formatDate(new Date(redData[i][0]), tz, 'dd/MM/yyyy HH:mm'),

        points: redData[i][4],

        serialNumber: redData[i][6],

        pinCode: redData[i][7],

        fulfilledDate: redData[i][8] ? Utilities.formatDate(new Date(redData[i][8]), tz, 'dd/MM/yyyy HH:mm') : null

      };

      if (status === 'Pending') pending = row;

      else if (status === 'Fulfilled') fulfilledList.push(row);

    }

  }


  return {
    balance: getPointsBalance_(user.email),
    toRedeem: POINTS_TO_REDEEM,
    canRedeem: getPointsBalance_(user.email) >= POINTS_TO_REDEEM && !pending,
    hasPending: !!pending,
    pending: pending,
    fulfilled: fulfilledList.length ? fulfilledList[fulfilledList.length - 1] : null,
    history: history
  };
}

// กดปุ่ม "แลกแต้ม" — หักแต้มทันที แล้วสร้างคำขอให้แอดมินไปกรอกลิงก์เติม LINE credit ตามจริง
function requestRedeem() {

  const user = requireLogin_();

  const balance = getPointsBalance_(user.email);

  if (balance < POINTS_TO_REDEEM) throw new Error('แต้มสะสมยังไม่ถึง ' + POINTS_TO_REDEEM + ' แต้ม ไม่สามารถแลกได้');

  const sh = getSheet_(SHEET_REDEMPTIONS);

  const data = sh.getDataRange().getValues();

  for (let i = 1; i < data.length; i++) {

    if (String(data[i][1]).toLowerCase() === user.email.toLowerCase() && data[i][5] === 'Pending') {

      throw new Error('คุณมีคำขอแลกแต้มที่รอดำเนินการอยู่แล้ว กรุณารอแอดมินติดต่อกลับก่อน');

    }

  }

  const code = getNextAvailableCode_();

  if (!code) {

    // รหัสในคลังหมด บันทึกเป็นสถานะรอ ให้แอดมินเติมรหัส/กรอกมือทีหลัง

    sh.appendRow([new Date(), user.email, user.name, user.dept, balance, 'Pending', '', '', '', '']);

    return { ok: true, points: balance, autoFilled: false };

  }

  sh.appendRow([new Date(), user.email, user.name, user.dept, balance, 'Fulfilled', code.serialNumber, code.pinCode, new Date(), 'ระบบอัตโนมัติ']);

  markCodeUsed_(code.rowIndex, user);

  const remaining = countAvailableCodes_();

  if (remaining < CODESTOCK_LOW_THRESHOLD) notifyAdminLowStock_(remaining);

  return { ok: true, points: balance, autoFilled: true, serialNumber: code.serialNumber, pinCode: code.pinCode };

}


/* ---------- ฝั่ง Admin: จัดการคำขอแลกแต้ม ---------- */
function getPendingRedemptions() {
  requireAdmin_();
  const sh = getSheet_(SHEET_REDEMPTIONS);
  const data = sh.getDataRange().getValues();
  const tz = Session.getScriptTimeZone() || 'Asia/Bangkok';
  const out = [];
  for (let i = 1; i < data.length; i++) {
    if (data[i][5] === 'Pending') {
      out.push({
        rowIndex: i + 1,
        date: Utilities.formatDate(new Date(data[i][0]), tz, 'dd/MM/yyyy HH:mm'),
        email: data[i][1],
        name: data[i][2],
        dept: data[i][3],
        points: data[i][4]
      });
    }
  }
  return out;
}

// แอดมินกรอกลิงก์/รหัสเติม LINE credit จริงที่ส่งให้พนักงานแล้ว เพื่อบันทึกไว้และให้ขึ้นในหน้าแต้มของพนักงานคนนั้น
function fulfillRedemption(rowIndex, serialNumber, pinCode) {

