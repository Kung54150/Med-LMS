          <text x="258" y="86" text-anchor="middle">ไม่วินิจฉัย ไม่แนะนำยา</text>
          <rect x="360" y="34" width="140" height="62" rx="9" fill="#e0f2fe" stroke="#0284c7" stroke-width="2"/>
