/** จัดรูปลายเซ็นทุกรูปในชีตที่เปิดอยู่ ให้พอดีช่องและอยู่กึ่งกลาง */
function Ojt_fitSignatures() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sh = ss.getActiveSheet();
  var imgs = sh.getImages();

  if (!imgs.length) {
    ss.toast('ไม่พบรูปในชีตนี้ — เปิดแท็บฟอร์ม OJT ที่สร้างไว้ก่อน แล้วรันใหม่', 'ไม่มีอะไรให้จัด', 8);
    return 0;
  }

  var padX = 6, padY = 4;    // เว้นขอบในช่อง (พิกเซล) ปรับได้ตามชอบ
  var n = 0;

  imgs.forEach(function (img) {
    var cell   = img.getAnchorCell();
    var merged = cell.getMergedRanges();
    var rng    = (merged && merged.length) ? merged[0] : cell;

    var r0 = rng.getRow(), c0 = rng.getColumn();

    var boxW = 0, boxH = 0;
    for (var c = 0; c < rng.getNumColumns(); c++) boxW += sh.getColumnWidth(c0 + c);
    for (var r = 0; r < rng.getNumRows();    r++) boxH += sh.getRowHeight(r0 + r);

    var maxW = Math.max(10, boxW - padX * 2);
    var maxH = Math.max(10, boxH - padY * 2);

    var w = img.getWidth(), h = img.getHeight();
    if (!w || !h) return;

    var k  = Math.min(maxW / w, maxH / h, 1);   // ย่ออย่างเดียว ไม่ขยาย
    var nw = Math.max(1, Math.round(w * k));
    var nh = Math.max(1, Math.round(h * k));

    img.setWidth(nw).setHeight(nh);
    img.setAnchorCell(sh.getRange(r0, c0));
    img.setAnchorCellXOffset(Math.max(0, Math.round((boxW - nw) / 2)));
    img.setAnchorCellYOffset(Math.max(0, Math.round((boxH - nh) / 2)));
    n++;
  });

  ss.toast('จัดลายเซ็นให้พอดีช่องแล้ว ' + n + ' รูป', 'เสร็จสิ้น', 6);
  return n;
}
/** ล็อกลายเซ็นทุกรูปในชีตที่เปิดอยู่ ให้อยู่ในกรอบคอลัมน์ P–T และ 2 แถวแรกของบล็อก */

function Ojt_lockSignatures() {

  /* ===== ค่าที่ปรับได้ ===== */

  var COL_FIRST      = 16;   // P  (A=1, B=2, ... P=16)

  var COL_LAST       = 20;   // T

  var FIRST_ROW      = 13;   // แถวแรกของบล็อกพนักงานคนแรก

  var ROWS_PER_PERSON = 3;   // 1 คนใช้กี่แถว

  var ROWS_FOR_SIG   = 2;    // ลายเซ็นกินกี่แถวจากแถวแรกของบล็อก (13-14)

  var PAD            = 4;    // เว้นขอบในกรอบ (พิกเซล)

  /* ========================= */

  var ss = SpreadsheetApp.getActiveSpreadsheet();

  var sh = ss.getActiveSheet();

  var imgs = sh.getImages();

  if (!imgs.length) {

    ss.toast('ไม่พบรูปในชีตนี้ — เปิดแท็บฟอร์ม OJT ก่อน แล้วรันใหม่', 'ไม่มีอะไรให้จัด', 8);

    return 0;

  }

  // ความกว้างรวมของกรอบ P–T

  var boxW = 0;

  for (var c = COL_FIRST; c <= COL_LAST; c++) boxW += sh.getColumnWidth(c);

  var n = 0, skipped = 0;

  imgs.forEach(function (img) {

    var nowRow = img.getAnchorCell().getRow();

    // รูปนี้เป็นของพนักงานคนที่เท่าไร คิดจากแถวที่มันอยู่ตอนนี้

    var idx = Math.floor((nowRow - FIRST_ROW) / ROWS_PER_PERSON);

    if (idx < 0) { skipped++; return; }              // รูปที่อยู่เหนือตาราง เช่น โลโก้ ไม่ต้องยุ่ง

    var top = FIRST_ROW + idx * ROWS_PER_PERSON;     // แถวบนของบล็อกคนนี้

    var boxH = 0;

    for (var r = 0; r < ROWS_FOR_SIG; r++) boxH += sh.getRowHeight(top + r);

    var maxW = Math.max(10, boxW - PAD * 2);

    var maxH = Math.max(10, boxH - PAD * 2);

    var w = img.getWidth(), h = img.getHeight();

    if (!w || !h) return;

    // ย่อเฉพาะเมื่อเกินกรอบ ถ้าอยู่ในกรอบอยู่แล้วคงขนาดเดิม

    var k = Math.min(maxW / w, maxH / h, 1);

    var nw = Math.max(1, Math.round(w * k));

    var nh = Math.max(1, Math.round(h * k));

    if (k < 1) img.setWidth(nw).setHeight(nh);

    img.setAnchorCell(sh.getRange(top, COL_FIRST));

    img.setAnchorCellXOffset(Math.max(0, Math.round((boxW - nw) / 2)));

    img.setAnchorCellYOffset(Math.max(0, Math.round((boxH - nh) / 2)));

    n++;

  });

  ss.toast('ล็อกตำแหน่งลายเซ็นแล้ว ' + n + ' รูป'

         + (skipped ? ' (ข้าม ' + skipped + ' รูปที่อยู่นอกตาราง)' : ''), 'เสร็จสิ้น', 6);

  return n;

}
/** เติมหัวฟอร์ม OJT: หลักสูตร / วันที่ / เวลา / ถึงเวลา
 *  ค้นหาจากข้อความป้ายกำกับในฟอร์ม แล้วเขียนลงช่องถัดไปทางขวา */
function Ojt_fillHeader_(sh, course) {
  var TZ = Session.getScriptTimeZone() || 'Asia/Bangkok';

  var rows = Math.min(14, sh.getMaxRows());
  var cols = Math.min(30, sh.getMaxColumns());
  var vals = sh.getRange(1, 1, rows, cols).getValues();

  var key = function (t) { return String(t == null ? '' : t).replace(/\s+/g, ''); };

  function put(label, value, exact) {
    if (!value) return false;
    for (var r = 0; r < vals.length; r++) {
      for (var c = 0; c < vals[r].length; c++) {
        var t = key(vals[r][c]);
        if (!t) continue;
        var hit = exact ? (t === label) : (t.indexOf(label) !== -1);
        if (!hit) continue;
        var cell = sh.getRange(r + 1, c + 2);
        var m = cell.getMergedRanges();
        if (m.length) cell = m[0];
        cell.setValue(value);
        return true;
      }
    }
    return false;
  }

  var d = course.publishAt ? new Date(course.publishAt) : null;
  if (d && isNaN(d.getTime())) d = null;

  var dateStr  = d ? Utilities.formatDate(d, TZ, 'dd/MM/yyyy') : '';
  var timeFrom = d ? Utilities.formatDate(d, TZ, 'HH:mm') : '';
  var timeTo   = d ? Utilities.formatDate(new Date(d.getTime() + 60 * 60 * 1000), TZ, 'HH:mm') : '';

  put('หลักสูตร', course.title);
  put('วัน/เดือน/ปี', dateStr);
  put('ถึงเวลา', timeTo);        // ต้องทำก่อน "เวลา" เสมอ
  put('เวลา', timeFrom, true);   // true = ต้องตรงเป๊ะทั้งช่อง

  return { date: dateStr, from: timeFrom, to: timeTo, hasPublishDate: !!d };
}
/** เติมหัวฟอร์ม OJT — รองรับป้ายกำกับที่เป็นเซลล์รวม */
function Ojt_fillHeader2_(sh, course) {
  var TZ = Session.getScriptTimeZone() || 'Asia/Bangkok';

  var rows = Math.min(14, sh.getMaxRows());
  var cols = Math.min(30, sh.getMaxColumns());
  var vals = sh.getRange(1, 1, rows, cols).getValues();

  var key = function (t) { return String(t == null ? '' : t).replace(/\s+/g, ''); };

  function put(label, value, exact) {
    if (!value) return false;

    for (var r = 0; r < vals.length; r++) {
      for (var c = 0; c < vals[r].length; c++) {
        var t = key(vals[r][c]);
        if (!t) continue;

        var hit = exact ? (t === label) : (t.indexOf(label) !== -1);
        if (!hit) continue;

        // หาขอบขวาสุดของช่องป้าย (เผื่อป้ายเป็นเซลล์รวม) แล้วข้ามไปช่องถัดไป
        var labelCell = sh.getRange(r + 1, c + 1);
        var lm = labelCell.getMergedRanges();
        var col = lm.length ? lm[0].getLastColumn() + 1 : c + 2;

        var target = sh.getRange(r + 1, col);
        var tm = target.getMergedRanges();
        if (tm.length) target = tm[0].getCell(1, 1);   // ถ้าช่องปลายทางเป็นเซลล์รวม ให้เขียนที่มุมซ้ายบน

        target.setValue(value);
        return true;
      }
    }
    return false;
  }

  var d = course.publishAt ? new Date(course.publishAt) : null;
  if (d && isNaN(d.getTime())) d = null;

  var dateStr  = d ? Utilities.formatDate(d, TZ, 'dd/MM/yyyy') : '';
  var timeFrom = d ? Utilities.formatDate(d, TZ, 'HH:mm') : '';
  var timeTo   = d ? Utilities.formatDate(new Date(d.getTime() + 60 * 60 * 1000), TZ, 'HH:mm') : '';

  put('หลักสูตร', course.title);
  put('วัน/เดือน/ปี', dateStr);
  put('ถึงเวลา', timeTo);
  put('เวลา', timeFrom, true);

  return { date: dateStr, from: timeFrom, to: timeTo, hasPublishDate: !!d };
}
/** สร้างฟอร์ม OJT แล้วส่งออกเป็น PDF ขนาด A4 พร้อมพิมพ์ */

function buildOjtExportPdf(courseId) {

  var PORTRAIT = true;   // true = แนวตั้ง · false = แนวนอน (ถ้าตารางตกขอบให้เปลี่ยนเป็น false)

  var res = buildOjtExportSheet(courseId);          // สร้างแท็บฟอร์มตามปกติก่อน

  var ss  = ss_();

  var gid = String(res.sheetUrl).split('#gid=')[1];

  var url = 'https://docs.google.com/spreadsheets/d/' + ss.getId() + '/export'

          + '?format=pdf'

          + '&gid=' + gid

          + '&size=A4'

          + '&portrait=' + (PORTRAIT ? 'true' : 'false')

          + '&fitw=true'                 // ย่อให้พอดีความกว้างหน้ากระดาษ

          + '&gridlines=false'           // ไม่พิมพ์เส้นตารางของ Google

          + '&printtitle=false'

          + '&sheetnames=false'

          + '&pagenumbers=false'

          + '&top_margin=0.35&bottom_margin=0.35&left_margin=0.35&right_margin=0.35';

    return {
    pdfUrl: url,

    sheetUrl: res.sheetUrl,

    sheetName: res.sheetName,

    count: res.count

  };

}
function Ojt_testPdf() { return buildOjtExportPdf('c4'); }
function Ojt_showPdfUrl() {
  var r = buildOjtExportPdf('c4');
  Logger.log('pdfUrl = [' + r.pdfUrl + ']');
  Logger.log('sheetUrl = [' + r.sheetUrl + ']');
}

/* ===== ระบบล็อกรหัสผ่านก่อนเข้าใช้งาน (ใช้ร่วมกันทั้ง 3 หน้า) ===== */
function checkAppPassword(pw) {
  var saved = PropertiesService.getScriptProperties().getProperty('APP_PASSWORD') || '';
  return saved !== '' && String(pw || '') === saved;
}


function checkFiles_run() {
  ['index', 'ShiftRequest', 'AdminShift', 'KpiGame'].forEach(function (name) {
    try {
      var c = HtmlService.createHtmlOutputFromFile(name).getContent();
      Logger.log(name
        + '  ->  NBSP = ' + ((c.match(/\u00A0/g) || []).length)
        + ' , ตัวล่องหน = ' + ((c.match(/[\u200B-\u200F\u2060\uFEFF\u00AD]/g) || []).length)
        + ' , ความยาว = ' + c.length);
    } catch (e) {
      Logger.log(name + '  ->  เปิดไม่ได้: ' + e.message);
    }
  });
}
function jsCheck_run() {
  ['index', 'ShiftRequest', 'AdminShift', 'KpiGame'].forEach(function (name) {
    var c = HtmlService.createTemplateFromFile(name).evaluate().getContent();
    var re = /<script[^>]*>([\s\S]*?)<\/script>/g;
    var m, i = 0;
    while ((m = re.exec(c)) !== null) {
      i++;
      try {
        new Function(m[1]);
        Logger.log(name + ' script#' + i + '  ->  OK  (ยาว ' + m[1].length + ')');
      } catch (e) {
        Logger.log(name + ' script#' + i + '  ->  *** พัง *** ' + e.message);
      }
    }
  });

  Logger.log('---------- index บรรทัด 100-130 ----------');
  var idx = HtmlService.createTemplateFromFile('index').evaluate().getContent().split('\n');
  for (var n = 100; n <= 130 && n <= idx.length; n++) {
    Logger.log(n + ': ' + idx[n - 1]);
  }
}

/* ================= แต้มสะสม: สิทธิ์ และรายงานสำหรับแอดมิน ================= */
// role ที่ "ไม่มีสิทธิสะสมแต้ม" — หัวหน้าแผนกให้ใส่ Role = head ในชีต Users
var POINTS_BLOCKED_ROLES = ['admin', 'hr', 'head'];

// คำในคอลัมน์ Position ที่ถือว่าเป็นหัวหน้า (ไม่มีสิทธิสะสมแต้ม)
var POINTS_HEAD_KEYWORD = 'หัวหน้า';

function isHeadByPosition_(email) {
  if (!email) return false;
  var data = getSheet_(SHEET_USERS).getDataRange().getValues();
  var h = data[0], iEmail = h.indexOf('Email'), iPos = h.indexOf('Position');
  if (iEmail < 0 || iPos < 0) return false;
  var key = String(email).trim().toLowerCase();
  for (var i = 1; i < data.length; i++) {
    if (String(data[i][iEmail]).trim().toLowerCase() === key) {
      return String(data[i][iPos] || '').indexOf(POINTS_HEAD_KEYWORD) >= 0;
    }
  }
  return false;
}

function canEarnPoints_(user) {
  var role = String((user && user.role) || 'employee').toLowerCase();
  if (POINTS_BLOCKED_ROLES.indexOf(role) !== -1) return false;      // admin / hr / head
  return !isHeadByPosition_(user && user.email);                     // คอลัมน์ Position มีคำว่า หัวหน้า
}

// ตารางแต้มของพนักงานทุกคน (เรียกได้เฉพาะแอดมิน / HR)
function getAllEmployeePoints() {
  requireAdmin_();
  var tz = Session.getScriptTimeZone() || 'Asia/Bangkok';

  var users = getSheet_(SHEET_USERS).getDataRange().getValues();
  var h = users[0];
  var iEmail = h.indexOf('Email'), iName = h.indexOf('Name'), iDept = h.indexOf('Department'),
      iRole = h.indexOf('Role'), iPos = h.indexOf('Position');

  var rows = {}, order = [];
  for (var i = 1; i < users.length; i++) {
    var email = String(users[i][iEmail] || '').trim();
    if (!email) continue;
    var role = String(users[i][iRole] || 'employee').toLowerCase();
    var pos = iPos >= 0 ? String(users[i][iPos] || '') : '';
    var isHead = pos.indexOf(POINTS_HEAD_KEYWORD) >= 0;
    var key = email.toLowerCase();
    rows[key] = {
      email: email,
      name: String(users[i][iName] || email),
      dept: String(users[i][iDept] || '-'),
      role: role,
      position: pos,
      canEarn: POINTS_BLOCKED_ROLES.indexOf(role) === -1 && !isHead,
      earned: 0, redeemed: 0, balance: 0, lessons: 0, pending: 0, lastEarn: ''
    };
    order.push(key);
  }

  var pts = getSheet_(SHEET_POINTS).getDataRange().getValues();
  var lastDate = {};
  for (var p = 1; p < pts.length; p++) {
    var k = String(pts[p][1] || '').toLowerCase();
    if (!rows[k]) continue;
    rows[k].earned += Number(pts[p][7]) || 0;
    rows[k].lessons++;
    var d = pts[p][0];
    if (d instanceof Date && (!lastDate[k] || d > lastDate[k])) {
      lastDate[k] = d;
      rows[k].lastEarn = Utilities.formatDate(d, tz, 'dd/MM/yyyy');
    }
  }

  var red = getSheet_(SHEET_REDEMPTIONS).getDataRange().getValues();
  for (var r = 1; r < red.length; r++) {
    var k2 = String(red[r][1] || '').toLowerCase();
    if (!rows[k2]) continue;
    rows[k2].redeemed += Number(red[r][4]) || 0;
    if (String(red[r][5]) === 'Pending') rows[k2].pending++;
  }

  var out = [];
  for (var j = 0; j < order.length; j++) {
    var row = rows[order[j]];
    row.balance = row.earned - row.redeemed;
    out.push(row);
  }
  out.sort(function (a, b) {
    if (b.balance !== a.balance) return b.balance - a.balance;
    if (b.earned !== a.earned) return b.earned - a.earned;
    return String(a.name).localeCompare(String(b.name));
  });
  return out;
}
